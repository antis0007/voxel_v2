  { "op": "spawn_enemy", "kind": "Ruin Walker", "expect": { "spawned": { "min": 0 } } },
  { "op": "spawn_enemy", "kind": "Great Rock Worm", "expect": { "spawned": { "min": 0 } } },
  { "op": "enemies", "radius_m": 48, "expect": { "count": { "min": 3 } } },
  { "op": "clear_enemies", "expect": { "left": 0 } }
] }
