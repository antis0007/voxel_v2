// Footstep sound per block, by engine_audio::Surface. Blocks without a row
// fall back on their material physics: liquids wade, powders sound as Soil,
// conductive solids as Metal, flammable solids as Wood, everything else as Stone.
// `cargo test footstep` checks that every row parses and every block resolves.
(
    blocks: {
        Grass: Grass,
        Dirt: Soil,
        Sand: Sand,
        Sandstone: Stone,
        SnowGrass: Snow,
        Water: Water,
        Log: Wood,
        Leaves: Grass,
        Bush: Grass,
        PineLeaves: Grass,
        Gravel: Sand,
        Clay: Soil,
        Mud: Soil,
        Ash: Soil,
        Ice: Stone,
        Planks: Wood,
        FungalSoil: Soil,
        MushroomStem: Wood,
        GlowCap: Grass,
        RedCap: Grass,
        AmberCap: Grass,
        UmberCap: Grass,
        GroveMoss: Grass,
        SalvageCrate: Wood,
        Workbench: Wood,
        StorageCrate: Wood,
        Bookcase: Wood,
        Bed: Grass,
        Smelter: Metal,
        CoalGenerator: Metal,
        Crusher: Metal,
        ElectricFurnace: Metal,
        FeedHopper: Metal,
        ItemPipe: Metal,
        PowerCable: Metal,
        Bioreactor: Metal,
        AlloyKiln: Metal,
        Fabricator: Metal,
        Cultivator: Metal,
        MiningDrill: Metal,
        Quarry: Metal,
        WaterPump: Metal,
        FluidPipe: Metal,
        WaterTank: Metal,
        OreWasher: Metal,
        RigidCore: Metal,
        BatteryBank: Metal,
        CokeOven: Metal,
        BlastFurnace: Metal,
        InductionCasing: Metal,
        InductionPort: Metal,
        InductionCell: Metal,
        InductionProvider: Metal,
        Transformer: Metal,
        Assembler: Metal,
    },
)
