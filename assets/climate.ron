        sst_genesis_c: 26.0,
        sst_decay_c: 24.0,
        max_genesis_land: 0.2,
        lifetime_days: (5.0, 8.5),
        initial_intensity: 0.2,
        intensify_per_day: 0.55,
        land_decay_per_day: 1.2,
        cold_decay_per_day: 0.5,
        potential_wind_ms: (45.0, 80.0),
        radius_rad: (0.05, 0.075),
        eyewall_frac: (0.145, 0.215),
        holland_b: (1.2, 1.8),
        inflow_deg: 20.0,
        band_gain: 0.15,
        band_wrap: 2.4,
        beta_deg_per_day: 1.0,
        trade_deg_per_day: 5.0,
        westerly_deg_per_day: 8.0,
        recurve_lat_deg: 24.0,
        category_ms: (33.0, 43.0, 50.0, 58.0, 70.0),
