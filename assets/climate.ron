// Storm catalogue dials (crates/worldgen/src/sphere/weather/storms.rs).
// Winds in m/s, radii in radians of arc on the unit planet, times in days.
// flow_per_ms maps m/s into CloudSky::wind units (radians per model unit);
// the app reads 0.08 flow as its authored wind speed.
