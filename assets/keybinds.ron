// Default input bindings. Each action has up to two bindings; the user's
// overrides live in keybinds.ron in the save directory and win per action.
// Key names are winit KeyCode names; mouse names are MouseLeft, MouseRight,
// MouseMiddle, MouseBack, MouseForward. Mouse buttons only drive held actions.
// Pad names are Pad plus a standard-layout button: PadSouth (A), PadEast (B),
// PadWest (X), PadNorth (Y), PadLeftBumper, PadRightBumper, PadLeftTrigger,
// PadRightTrigger, PadSelect, PadLeftStick, PadRightStick, PadDPadUp/Down/Left/Right,
// and the left stick's directions PadLeftStickUp/Down/Left/Right. PadStart is
// fixed to the pause menu and PadEast also closes open panels.
// Ctrl+Z undoes and Ctrl+Y or Ctrl+Shift+Z redoes, beside the Undo and Redo bindings.
[
    (action: "Forward", label: "Forward", group: "Movement", keys: ["KeyW", "PadLeftStickUp"]),
    (action: "Back", label: "Back", group: "Movement", keys: ["KeyS", "PadLeftStickDown"]),
    (action: "Left", label: "Strafe Left", group: "Movement", keys: ["KeyA", "PadLeftStickLeft"]),
    (action: "Right", label: "Strafe Right", group: "Movement", keys: ["KeyD", "PadLeftStickRight"]),
    (action: "Jump", label: "Jump", group: "Movement", keys: ["Space", "PadSouth"]),
    (action: "Sneak", label: "Sneak", group: "Movement", keys: ["ShiftLeft", "ShiftRight"]),
    (action: "Sprint", label: "Sprint", group: "Movement", keys: ["ControlLeft", "ControlRight"]),
    (action: "Dash", label: "Dash", group: "Movement", keys: ["CapsLock", "MouseBack"]),
    (action: "Break", label: "Break", group: "Use", keys: ["MouseLeft", "PadRightTrigger"]),
    (action: "Place", label: "Use / Place", group: "Use", keys: ["MouseRight", "PadLeftTrigger"]),
    (action: "Pick", label: "Pick Block", group: "Use", keys: ["MouseMiddle", "PadRightStick"]),
    (action: "Cast", label: "Cast Spell", group: "Use", keys: ["KeyR", "PadRightBumper"]),
    (action: "Inspect", label: "Inspect Equipment", group: "Use", keys: ["KeyI"]),
    (action: "Zoom", label: "Zoom", group: "Use", keys: ["MouseForward", "KeyO"]),
    (action: "Interact", label: "Interact", group: "Use", keys: ["KeyG", "PadWest"]),
    (action: "SwapHands", label: "Swap Hands", group: "Use", keys: ["KeyF"]),
    (action: "NextSpell", label: "Next Spell", group: "Use", keys: ["KeyT", "PadLeftBumper"]),
    (action: "Lamp", label: "Lamp", group: "Use", keys: ["KeyL", "PadDPadUp"]),
    (action: "ToolHand", label: "Hand", group: "Tools", keys: ["KeyZ"]),
    (action: "ToolBrush", label: "Brush", group: "Tools", keys: ["KeyX"]),
    (action: "ToolBuilders", label: "Builder Wand", group: "Tools", keys: ["KeyC"]),
    (action: "ToolDestructor", label: "Destructor Wand", group: "Tools", keys: ["KeyV"]),
    (action: "ToolArea", label: "Area Tool", group: "Tools", keys: ["KeyJ"]),
    (action: "ToolExplosive", label: "Explosive Wand", group: "Tools", keys: ["KeyH"]),
    (action: "RangeDown", label: "Tool Range Down", group: "Tools", keys: ["BracketLeft"]),
    (action: "RangeUp", label: "Tool Range Up", group: "Tools", keys: ["BracketRight"]),
    (action: "Inventory", label: "Inventory", group: "Panels", keys: ["KeyE", "Tab"]),
    (action: "CreativePanel", label: "Creative Panel", group: "Panels", keys: ["KeyB"]),
    (action: "WandAtelier", label: "Wand Atelier", group: "Panels", keys: ["KeyU"]),
    (action: "QuickSelect", label: "Quick Select", group: "Panels", keys: ["KeyQ", "PadNorth"]),
    (action: "Map", label: "World Map", group: "Panels", keys: ["KeyM", "PadSelect"]),
    (action: "Waypoint", label: "Add Waypoint", group: "Interface", keys: ["KeyN", "PadDPadDown"]),
    (action: "Minimap", label: "Minimap", group: "Interface", keys: []),
    (action: "Records", label: "Statistics", group: "Panels", keys: []),
    (action: "GoalTrack", label: "Goal Tracker", group: "Interface", keys: ["F6"]),
    // Alt+R prioritizes the tracked goal. Alt+U looks up the aimed-at block
    // or held item. Both shortcuts also work with custom bindings.
    (action: "RecipeLookup", label: "Show Recipe", group: "Interface", keys: []),
    (action: "UsesLookup", label: "Show Uses", group: "Interface", keys: []),
    (action: "ToggleHud", label: "HUD", group: "Interface", keys: ["F1"]),
    (action: "Screenshot", label: "Screenshot", group: "Interface", keys: ["F2"]),
    (action: "Debug", label: "Debug Overlay", group: "Interface", keys: ["F3"]),
    (action: "Fullscreen", label: "Fullscreen", group: "Interface", keys: ["F11"]),
    (action: "Hotbar1", label: "Slot 1", group: "Hotbar", keys: ["Digit1"]),
    (action: "Hotbar2", label: "Slot 2", group: "Hotbar", keys: ["Digit2"]),
    (action: "Hotbar3", label: "Slot 3", group: "Hotbar", keys: ["Digit3"]),
    (action: "Hotbar4", label: "Slot 4", group: "Hotbar", keys: ["Digit4"]),
    (action: "Hotbar5", label: "Slot 5", group: "Hotbar", keys: ["Digit5"]),
    (action: "Hotbar6", label: "Slot 6", group: "Hotbar", keys: ["Digit6"]),
    (action: "Hotbar7", label: "Slot 7", group: "Hotbar", keys: ["Digit7"]),
    (action: "Hotbar8", label: "Slot 8", group: "Hotbar", keys: ["Digit8"]),
    (action: "Hotbar9", label: "Slot 9", group: "Hotbar", keys: ["Digit9"]),
    (action: "HotbarPrev", label: "Previous Slot", group: "Hotbar", keys: ["PadDPadLeft"]),
    (action: "HotbarNext", label: "Next Slot", group: "Hotbar", keys: ["PadDPadRight"]),
    (action: "Undo", label: "Undo", group: "Building", keys: ["Backspace"]),
    (action: "Redo", label: "Redo", group: "Building", keys: []),
    (action: "BlueprintCorner", label: "Selection Corner", group: "Blueprints", keys: ["KeyK"]),
    (action: "BlueprintCopy", label: "Copy", group: "Blueprints", keys: ["KeyY"]),
    (action: "BlueprintCut", label: "Cut", group: "Blueprints", keys: ["Delete"]),
    (action: "BlueprintPaste", label: "Paste", group: "Blueprints", keys: ["KeyP"]),
    (action: "BlueprintRotate", label: "Rotate Clipboard", group: "Blueprints", keys: ["Period"]),
    (action: "BlueprintMirror", label: "Mirror Clipboard", group: "Blueprints", keys: ["Comma"]),
    (action: "Blueprints", label: "Blueprint List", group: "Blueprints", keys: ["KeyJ"]),
    (action: "Records", label: "Statistics", group: "Panels", keys: ["Backslash"]),
    (action: "SystemMap", label: "System Map", group: "Panels", keys: ["Semicolon"]),
    (action: "NavTarget", label: "Next Target", group: "Interface", keys: ["Quote"]),
]
