// Default input bindings. Each action has up to two bindings; the user's
// overrides live in keybinds.ron in the save directory and win per action.
// Key names are winit KeyCode names; mouse names are MouseLeft, MouseRight,
// MouseMiddle, MouseBack, MouseForward. Mouse buttons only drive held actions.
[
    (action: "Forward", label: "Forward", group: "Movement", keys: ["KeyW"]),
    (action: "Back", label: "Back", group: "Movement", keys: ["KeyS"]),
    (action: "Left", label: "Strafe Left", group: "Movement", keys: ["KeyA"]),
    (action: "Right", label: "Strafe Right", group: "Movement", keys: ["KeyD"]),
    (action: "Jump", label: "Jump", group: "Movement", keys: ["Space"]),
    (action: "Sneak", label: "Sneak", group: "Movement", keys: ["ShiftLeft", "ShiftRight"]),
    (action: "Sprint", label: "Sprint", group: "Movement", keys: ["ControlLeft", "ControlRight"]),
    (action: "Dash", label: "Dash", group: "Movement", keys: ["CapsLock", "MouseBack"]),
    (action: "Break", label: "Break", group: "Use", keys: ["MouseLeft"]),
    (action: "Place", label: "Place", group: "Use", keys: ["MouseRight"]),
    (action: "Pick", label: "Pick Block", group: "Use", keys: ["MouseMiddle"]),
    (action: "Cast", label: "Cast Spell", group: "Use", keys: ["KeyR"]),
    (action: "Inspect", label: "Inspect Equipment", group: "Use", keys: ["KeyI"]),
    (action: "Zoom", label: "Zoom", group: "Use", keys: ["MouseForward", "KeyO"]),
    (action: "Interact", label: "Interact", group: "Use", keys: ["KeyF"]),
    (action: "NextSpell", label: "Next Spell", group: "Use", keys: ["KeyT"]),
    (action: "Lamp", label: "Lamp", group: "Use", keys: ["KeyL"]),
    (action: "ToolHand", label: "Hand", group: "Tools", keys: ["KeyZ"]),
    (action: "ToolBrush", label: "Brush", group: "Tools", keys: ["KeyX"]),
    (action: "ToolBuilders", label: "Builder Wand", group: "Tools", keys: ["KeyC"]),
    (action: "ToolDestructor", label: "Destructor Wand", group: "Tools", keys: ["KeyV"]),
    (action: "ToolArea", label: "Area Tool", group: "Tools", keys: ["KeyG"]),
    (action: "ToolExplosive", label: "Explosive Wand", group: "Tools", keys: ["KeyH"]),
    (action: "RangeDown", label: "Tool Range Down", group: "Tools", keys: ["BracketLeft"]),
    (action: "RangeUp", label: "Tool Range Up", group: "Tools", keys: ["BracketRight"]),
    (action: "Inventory", label: "Inventory", group: "Panels", keys: ["KeyE", "Tab"]),
    (action: "CreativePanel", label: "Creative Panel", group: "Panels", keys: ["KeyB"]),
    (action: "WandAtelier", label: "Wand Atelier", group: "Panels", keys: ["KeyU"]),
    (action: "QuickSelect", label: "Quick Select", group: "Panels", keys: ["KeyQ"]),
    (action: "Map", label: "World Map", group: "Panels", keys: ["KeyM"]),
    (action: "Waypoint", label: "Add Waypoint", group: "Interface", keys: ["KeyN"]),
    (action: "Minimap", label: "Minimap", group: "Interface", keys: []),
    (action: "ToggleHud", label: "HUD", group: "Interface", keys: ["F1"]),
    (action: "Screenshot", label: "Screenshot", group: "Interface", keys: ["F2"]),
    (action: "Debug", label: "Debug Overlay", group: "Interface", keys: ["F3"]),
    (action: "Fullscreen", label: "Fullscreen", group: "Interface", keys: ["F11"]),
    (action: "Hotbar1", label: "Slot 1", group: "Hotbar", keys: ["Digit1"]),
    (action: "Hotbar2", label: "Slot 2", group: "Hotbar", keys: ["Digit2"]),
    (action: "Hotbar3", label: "Slot 3", group: "Hotbar", keys: ["Digit3"]),
    (action: "Hotbar4", label: "Slot 4", group: "Hotbar", keys: ["Digit4"]),
    (action: "Hotbar5", label: "Slot 5", group: "Hotbar", keys: ["Digit5"]),
    (action: "Hotbar6", label: "Slot 6", group: "Hotbar", keys: ["Digit6"]),
    (action: "Hotbar7", label: "Slot 7", group: "Hotbar", keys: ["Digit7"]),
    (action: "Hotbar8", label: "Slot 8", group: "Hotbar", keys: ["Digit8"]),
    (action: "Hotbar9", label: "Slot 9", group: "Hotbar", keys: ["Digit9"]),
]
