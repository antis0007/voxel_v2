// Verified macro modules for the microcontroller floorplanner (engine_chip).
// A grid square is a placement site, not a transistor. Figures are characterised
// on the one process the first slice ships: a prepared 8 µm NMOS-class blank,
// roughly the class of 1970s single-chip controllers. Delays in ns, power in µW,
// energy per use in nJ, conversion and timer periods in µs.
ChipTable(
    processes: [
        Process(
            id: "p8um",
            name: "Prepared 8 µm blank",
            site_um: 120.0,
            vdd: 5.0,
            wire_ns_per_site: 0.9,
            wire_ns_per_site2: 0.04,
            via_ns: 1.5,
            wire_pf_per_site: 0.15,
            margin: 1.25,
            max_layers: 3,
            overlay_um: 2.0,
            wafer_mm: 12.0,
        ),
    ],
    // Fabrication labs for wafer lots. Random defects follow Y = exp(-D·A)
    // with D in defects/cm²; sigma is the die-to-die spread of the critical
    // path; overlay is the 1-sigma mask alignment error in µm; a clean or
    // strip step picks up contamination with probability `contamination`.
    // `filters` is extra material per step for the cleaner lab.
    labs: [
        Lab(id: "bench", name: "Open Bench", defect_per_cm2: 18.0, sigma: 0.08, overlay_um: 1.4, contamination: 0.10, filters: 0),
        Lab(id: "clean", name: "Clean Hood", defect_per_cm2: 4.0, sigma: 0.03, overlay_um: 0.6, contamination: 0.02, filters: 4),
    ],
    modules: [
        Module(
            id: "supply_pad",
            name: "Supply Pads",
            role: Supply,
            size: (2, 1),
            edge: true,
            delay_ns: 0.0,
            idle_uw: 50.0,
            ports: [
                Port(name: "vdd", signal: Power, dir: Drive, width: 1, at: (0, 0)),
                Port(name: "por", signal: Reset, dir: Drive, width: 1, at: (1, 0)),
            ],
        ),
        Module(
            id: "rc_osc",
            name: "RC Oscillator",
            role: Clock,
            size: (2, 2),
            delay_ns: 0.0,
            idle_uw: 400.0,
            hz: 4000000,
            ports: [
                Port(name: "vdd", signal: Power, dir: Sink, width: 1, at: (0, 0)),
                Port(name: "clk", signal: Clock, dir: Drive, width: 1, at: (1, 1)),
            ],
        ),
        Module(
            id: "core8",
            name: "Control Core",
            role: Core,
            size: (4, 4),
            delay_ns: 45.0,
            setup_ns: 30.0,
            idle_uw: 5000.0,
            run_uw: 380000.0,
            event_nj: 2.0,
            cpi: 4,
            soft_alu_cpi: 16,
            hz: 4000000,
            ports: [
                Port(name: "vdd", signal: Power, dir: Sink, width: 1, at: (0, 0)),
                Port(name: "clk", signal: Clock, dir: Sink, width: 1, at: (1, 0)),
                Port(name: "rst", signal: Reset, dir: Sink, width: 1, at: (2, 0)),
                Port(name: "imem", signal: MemBus, dir: Drive, width: 8, at: (3, 1)),
                Port(name: "dmem", signal: MemBus, dir: Drive, width: 8, at: (3, 2), optional: true),
                Port(name: "pbus", signal: PeriphBus, dir: Drive, width: 8, at: (0, 3)),
                Port(name: "alu", signal: AluBus, dir: Drive, width: 8, at: (2, 3), optional: true),
            ],
        ),
        Module(
            id: "alu8",
            name: "ALU",
            role: Alu,
            size: (2, 3),
            combinational: true,
            delay_ns: 60.0,
            idle_uw: 300.0,
            event_nj: 0.5,
            ports: [
                Port(name: "vdd", signal: Power, dir: Sink, width: 1, at: (0, 0)),
                Port(name: "op", signal: AluBus, dir: Sink, width: 8, at: (1, 0), optional: true),
                Port(name: "carry_in", signal: Data, dir: Sink, width: 8, at: (0, 2), optional: true),
                Port(name: "carry_out", signal: Data, dir: Drive, width: 8, at: (1, 2), optional: true),
            ],
        ),
        Module(
            id: "rom256",
            name: "Mask ROM",
            role: Rom,
            size: (3, 3),
            delay_ns: 250.0,
            idle_uw: 300.0,
            event_nj: 0.3,
            bytes: 256,
            ports: [
                Port(name: "vdd", signal: Power, dir: Sink, width: 1, at: (0, 0)),
                Port(name: "bus", signal: MemBus, dir: Sink, width: 8, at: (0, 1)),
            ],
        ),
        Module(
            id: "sram64",
            name: "SRAM",
            role: Sram,
            size: (3, 3),
            delay_ns: 180.0,
            idle_uw: 600.0,
            event_nj: 0.4,
            bytes: 64,
            ports: [
                Port(name: "vdd", signal: Power, dir: Sink, width: 1, at: (0, 0)),
                Port(name: "bus", signal: MemBus, dir: Sink, width: 8, at: (0, 1)),
            ],
        ),
        Module(
            id: "timer8",
            name: "Timer 8-bit",
            role: Timer,
            size: (2, 1),
            delay_ns: 30.0,
            idle_uw: 60.0,
            time_us: 125000.0,
            ports: [
                Port(name: "vdd", signal: Power, dir: Sink, width: 1, at: (0, 0)),
                Port(name: "bus", signal: PeriphBus, dir: Sink, width: 8, at: (1, 0)),
            ],
        ),
        Module(
            id: "timer16",
            name: "Timer 16-bit",
            role: Timer,
            size: (2, 2),
            delay_ns: 35.0,
            idle_uw: 250.0,
            time_us: 1000.0,
            ports: [
                Port(name: "vdd", signal: Power, dir: Sink, width: 1, at: (0, 0)),
                Port(name: "clk", signal: Clock, dir: Sink, width: 1, at: (1, 0)),
                Port(name: "bus", signal: PeriphBus, dir: Sink, width: 8, at: (0, 1)),
            ],
        ),
        Module(
            id: "watchdog",
            name: "Watchdog",
            role: Watchdog,
            size: (2, 1),
            delay_ns: 25.0,
            idle_uw: 80.0,
            ports: [
                Port(name: "vdd", signal: Power, dir: Sink, width: 1, at: (0, 0)),
                Port(name: "bus", signal: PeriphBus, dir: Sink, width: 8, at: (1, 0)),
            ],
        ),
        Module(
            id: "gpio4",
            name: "GPIO",
            role: Gpio,
            size: (2, 2),
            edge: true,
            delay_ns: 20.0,
            idle_uw: 100.0,
            event_nj: 0.2,
            channels: 4,
            ports: [
                Port(name: "vdd", signal: Power, dir: Sink, width: 1, at: (0, 0)),
                Port(name: "bus", signal: PeriphBus, dir: Sink, width: 8, at: (1, 0)),
            ],
        ),
        Module(
            id: "adc8",
            name: "ADC",
            role: Adc,
            size: (2, 2),
            edge: true,
            delay_ns: 40.0,
            idle_uw: 500.0,
            event_nj: 50.0,
            channels: 1,
            time_us: 100.0,
            ports: [
                Port(name: "vdd", signal: Power, dir: Sink, width: 1, at: (0, 0)),
                Port(name: "bus", signal: PeriphBus, dir: Sink, width: 8, at: (1, 0)),
            ],
        ),
    ],
)
