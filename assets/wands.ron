// Wand appearance table, schema version 1 (crates/app/src/wand_appearance.rs).
//
// One row per visual family from docs/design/WAND_ECOSYSTEM_20261026.md. A
// family's sprite is authored pixel art, 16 texels wide, rows from the tip down
// to the butt. Keys: '.' empty; '1'-'4' the style's shaft material, darkest
// first; '5'-'7' the style's grip binding, darkest first; letters are the
// family's own materials below. The grip socket is the centre of the rows that
// carry grip keys; the casting origin sits on the topmost emitter row.
//
// pixel_m is a model-space texel. The held rig scales it by 0.84
// (assets/runtime/viewmodels/presentation.ron), so 0.006 reads as 5.0 mm.
// `styles` maps WandStyle::head 0-5 to a family; changing it changes how every
// saved wand looks, so append families instead of reordering.
(
    version: 1,
    pixel_m: 0.006,
    width: 16,
    styles: [
        "witchwood_switch",
        "shard_cluster",
        "bifurcated_focus",
        "astral_filament",
        "cinder_rod",
        "bone_needle",
    ],
    families: [
