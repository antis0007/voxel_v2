// Daily aerosol regimes. Every value is a physical coefficient applied to the
// active preset in `atmosphere.ron`; no colour is authored here. The LUTs turn
// them into sky, sun, cloud and terrain light, so a regime changes all of
// them consistently. One regime is picked per calendar day from the world
// seed and that day's weather (`crates/app/src/world/sky_air.rs`); the next
// day's blends in during deep night.
//
// density: multiplier on Mie scattering and on SkyArt haze extinction.
// height: multiplier on the Mie scale height (how high the aerosol reaches).
// angstrom: Angstrom exponent. Scattering per channel is beta * (lambda /
//   550 nm)^-angstrom at 680/550/440 nm. Fine smoke and sulfate (1.3-2.0)
//   scatter blue out of the sun's path; coarse dust (~0) scatters all alike.
// absorption: Mie absorption, 1/m, red/green/blue, added to the preset.
//   Soot absorbs flat; mineral dust absorbs blue.
// g: Mie phase asymmetry (forward-scatter tightness around the sun).
// ozone: multiplier on ozone absorption; deeper blue hour above 1.
// cirrus / stratus: weight multipliers per unit of that day's high cirrus or
//   low stratus.
(
    regimes: [
        // Washed by rain or a cold front: little aerosol, deep blue, a small
        // bright solar glow, pale clean sunset.
        (id: "clean", weight: 3.0, cirrus: 0.0, stratus: -0.5,
         density: 0.45, height: 0.9, angstrom: 1.4, absorption: (0.0, 0.0, 0.0), g: 0.78, ozone: 1.10),
        // Ordinary continental haze: shipped density with a mild spectral slope.
        (id: "continental", weight: 4.0, cirrus: 0.3, stratus: 0.0,
         density: 1.0, height: 1.0, angstrom: 1.0, absorption: (0.0, 0.0, 0.0), g: 0.76, ozone: 1.0),
        // Humid, swollen particles: low Angstrom, broad white glow, soft
        // pastel sunset, hazier distance.
        (id: "humid", weight: 2.5, cirrus: 0.0, stratus: 1.2,
         density: 2.2, height: 1.3, angstrom: 0.5, absorption: (0.0, 0.0, 0.0), g: 0.80, ozone: 1.0),
        // Fine smoke aloft: strong blue loss along long paths, red sun and
        // deep red twilight, slight soot absorption.
        (id: "smoke", weight: 1.0, cirrus: 0.6, stratus: -0.4,
         density: 2.4, height: 1.8, angstrom: 1.9, absorption: (0.25e-6, 0.30e-6, 0.36e-6), g: 0.72, ozone: 1.0),
        // Mineral dust: coarse grey scattering that absorbs blue; ochre
        // horizon, muted sky, shortened view.
        (id: "dust", weight: 0.8, cirrus: -0.3, stratus: -0.5,
         density: 2.8, height: 2.0, angstrom: 0.15, absorption: (0.10e-6, 0.30e-6, 0.85e-6), g: 0.74, ozone: 1.0),
        // High thin sulfate layer: lifted, fine, weakly forward-scattering
        // aerosol keeps scattered red light overhead after sunset.
        (id: "sulfate", weight: 1.2, cirrus: 1.4, stratus: -0.3,
         density: 1.6, height: 3.5, angstrom: 1.6, absorption: (0.0, 0.0, 0.0), g: 0.68, ozone: 1.25),
    ],
    // Air at the player, weighted by the biome blend there.
    regions: (
        desert: (density: 1.8, height: 1.5, angstrom: 0.3, absorption: (0.08e-6, 0.22e-6, 0.60e-6)),
        snow: (density: 0.55, height: 0.9, angstrom: 1.3, absorption: (0.0, 0.0, 0.0)),
    ),
)
