// Sparse inventory copy and complete spell cards. Standard items have no prose.
// Numeric properties belong in gameplay data and generated stat lines.
(
    keywords: [
        (name: "Burning", definition: "Takes fire damage over time; water or frost extinguishes it."),
        (name: "Wet", definition: "Extinguishes fire and strengthens shock and frost reactions."),
        (name: "Charged", definition: "Stores electrical charge."),
        (name: "Sealed", definition: "Blocks passage until its mechanism opens."),
    ],
    entries: [
        (key: "claim_stake", tier: Behavior,
            text: "Pairs mark land reserved from NPC construction.",
            codex: "A pair of placed stakes marks opposite corners. Use each stake to register the pair. Sneak and use either stake to release the claim. Removing either stake also releases it."),
        (key: "lightless_shaft", tier: Behavior,
            text: "Leads down to the Lightless from deep rock.",
            codex: "Set the shaft into a floor under deep rock, stand on it and use it to descend. The arrival chamber holds a return shaft to the previous shaft. In darkness the Hush closes in; a held torch, lamp or foxfire holds it off. The walls carry richer ore."),
        (key: "gilded_gate", tier: Behavior,
            text: "Leads to the Gilded Cave.",
            codex: "Set the gate into a floor, stand on it and use it to enter. The arrival landing holds a return gate to the previous gate; a second gate stands on the summit of the far grotto. Every cache in the cave holds treasure."),
        (key: "highfold_gate", tier: Behavior,
            text: "Leads up to the Highfold from open sky.",
            codex: "Set the gate under open sky with nothing overhead, stand on it and use it to rise. The arrival island holds a return gate to the previous gate. Islands hang over a shallow sea; a fall from the edge ends in the water."),
        (key: "gloaming_gate", tier: Behavior,
            text: "Leads into the Gloaming from deep woods.",
            codex: "Set the gate among many trees, stand on it and use it to enter. The arrival clearing holds a return gate to the previous gate. The forest is held at dusk; glowcaps light the floor under the giant trees."),
        (key: "rune_goggles", tier: Behavior,
            text: "Shows runes in their element colours.",
            codex: "Crystal lenses bound with lumen fibre. Wherever runes appear, on a wand page or carved around a circle, each shows its colour: fire, frost, shock, venom, water, force, life, earth, mana, forms and events."),
        (key: "survey_goggles", tier: Behavior,
            text: "Reveals protected boundaries through terrain.",
            codex: "Star glass lenses trace registered claims in teal, respawn bed protection in blue, and the first unpaired claim corner in amber."),
        (key: "hang_glider", tier: Behavior,
            text: "Trades height for forward speed.",
            codex: "Equip on the chest. Press Jump while falling to open the frame; press again to fold it. Look down to dive or up to flare. Wind changes ground speed. Slime boots cushion missed landings; the sling supplies a ground launch."),
        (key: "octo_arms", tier: Behavior,
            text: "Grips nearby floors, walls and ceilings.",
            codex: "Ballast shaft crews wore salvaged limbs to inspect the braid's anchor without scaffolds. Alt+Jump toggles grip; Jump rises and Sneak descends. Claws must reach solid surfaces. Hands remain free. The tally plate carries crew signatures."),
        (key: "burner_jetpack", tier: Behavior,
            text: "Burns bio-ethanol for lift.",
            codex: "Founders' inspection packs carried workers between braid couplings. Jump fires the burners. Alt+Sneak toggles hover; Sneak descends. Fuel loads from carried bio-ethanol. The last shift's fuel allowance is still stamped beside the valve."),
        (key: "induction_jetpack", tier: Behavior,
            text: "Draws lift from carried Charged batteries.",
            codex: "The Founders replaced hot inspection burners with induction coils after a braid strand scorched. Jump gives lift; Alt+Sneak toggles hover and Sneak descends. Carried Charged batteries supply the pack. Empty battery blocks supply nothing."),
        (key: "slime_boots", tier: Behavior,
            text: "Absorbs falls and rebounds off floors and walls.",
            codex: "Elastic fungal soles return falls as bounces without fall damage. Jump just before touchdown to pump the rebound higher; fast airborne wall hits spring back. Sneak settles the rebound. Keepers wore them beneath the Ballast's roofs."),
        (key: "slime_sling", tier: Behavior,
            text: "Charged fling toward the aim, weaker once midair.",
            codex: "Keepers stretched living garden gel between lumen-fibre straps to cross broken irrigation spans. Hold use, aim, then release; releasing at full stretch snaps harder. A weaker fling remains in the air until landing: aim up to arrest a fall, down to slam. Ballast children copied it."),
        (key: "power_kit", tier: Behavior,
            text: "Retains charge and upgrades when packed.",
            codex: "Placement restores charge and upgrades."),
        (key: "cinderbrand", tier: Behavior,
            text: "Finishers restore mana."),
        (key: "winterglass", tier: Behavior,
            text: "Chills targets that are not slowed."),
        (key: "kinetic_maul", tier: Behavior,
            text: "Hits launch loose objects."),
        (key: "lumen_helm", tier: Behavior,
            text: "Projects a lantern beam."),
        (key: "kinetic_greaves", tier: Behavior,
            text: "Dashes and jumps in mid-air.",
            codex: "Coil thrusters fire a short horizontal dash, once more in the air, and a second jump. Recharges on landing."),
        (key: "kinetic_vest", tier: Behavior,
            text: "Glides when opened in a fall.",
            codex: "A folding frame opens with Jump while falling and closes with Jump again. Looking down dives faster; looking up slows the frame."),
        (key: "kinetic_boots", tier: Behavior,
            text: "Runs along walls.",
            codex: "A grip field holds the wearer to a wall while sprinting; jumping kicks off it. Air control keeps speed through turns."),
        (key: "bore", tier: Behavior,
            text: "Excavates connected material.",
            codex: "Excavates connected cells of the targeted material; nearby footing remains intact."),
        (key: "legacy_focus", tier: Mechanic,
            text: "Casts selected spells."),
        (key: "wand", tier: Mechanic,
            text: "Casts spells from its equipped deck.",
            codex: "Deck order controls casting. The wand panel changes spell order and modifiers."),
        // Spell modifiers: numbers are generated from evaluator and effect rules.
        (key: "spell_16", tier: Mechanic,
            text: "Casts additional spells from the deck together."),
        (key: "spell_17", tier: Mechanic,
            text: "Casts additional spells from the deck together."),
        (key: "spell_18", tier: Mechanic,
            text: "Releases the following spell when the carrier hits.",
            codex: "Slot the trigger, carrier, then payload. Modifiers between the carrier and payload affect the payload."),
        (key: "spell_19", tier: Mechanic,
            text: "Steers bolts toward visible enemies."),
        (key: "spell_20", tier: Mechanic,
            text: "Adds wall ricochets, damage, and speed."),
        (key: "spell_21", tier: Mechanic,
            text: "Bores through terrain while increasing damage and reducing speed."),
        (key: "spell_22", tier: Mechanic,
            text: "Reduces cast cost, delay, and recharge.",
            codex: "The mana discount cannot exceed the cast cost and does not stack."),
        (key: "spell_23", tier: Mechanic,
            text: "Leaves elemental wakes and increases damage."),
        (key: "spell_26", tier: Mechanic,
            text: "Carves a crater and damages nearby enemies on impact."),
        (key: "spell_27", tier: Mechanic,
            text: "Restores health on direct hits."),
        (key: "spell_37", tier: Mechanic,
            text: "Widens bolt collision.",
            codex: "Changes projectile collision, not creature size."),
        (key: "spell_38", tier: Mechanic,
            text: "Targets the lanterncap before enemies."),
        (key: "spell_40", tier: Mechanic,
            text: "Copies the next cast without repeating its mana payment."),
        (key: "spell_41", tier: Mechanic,
            text: "Copies the next cast without repeating its mana payment."),
        (key: "spell_42", tier: Mechanic,
            text: "Bends bolts and drilling beams around a broad arc."),
        (key: "spell_43", tier: Mechanic,
            text: "Weaves bolts and drilling beams through a wide alternating path."),
        (key: "spell_44", tier: Mechanic,
            text: "Circles bolts and drilling beams through a tight local orbit."),
        (key: "spell_45", tier: Mechanic,
            text: "Restores health from base hit damage.",
            codex: "Healing uses base projectile damage, rank, and the damage modifier before shields, resistance, critical hits, and elemental reactions."),
        (key: "spell_46", tier: Mechanic,
            text: "May cancel projectiles after paying their cost.",
            codex: "The fizzle depends on cast timing and projectile order."),
        (key: "spell_47", tier: Mechanic,
            text: "Skips the next spell unless caster health falls below the threshold."),
        (key: "spell_48", tier: Mechanic,
            text: "Skips the next spell unless an enemy is visible."),
        (key: "spell_49", tier: Mechanic,
            text: "Replaces the next spell with the deck's first projectile."),
        (key: "spell_50", tier: Mechanic,
            text: "Chooses a curve, weave, or orbit for the cast."),
        (key: "spell_51", tier: Mechanic,
            text: ""),
        (key: "spell_52", tier: Mechanic,
            text: "",
            codex: "Lodestone keeps its lifetime ceiling."),
        (key: "spell_53", tier: Mechanic,
            text: ""),
        (key: "spell_54", tier: Mechanic,
            text: ""),
        (key: "spell_55", tier: Mechanic,
            text: ""),
        (key: "spell_56", tier: Mechanic,
            text: "Applies Burning on hit, or vaporizes Wet instead."),
        (key: "spell_57", tier: Mechanic,
            text: "Staggers enemies and increases damage against Wet targets."),
        (key: "spell_58", tier: Mechanic,
            text: "Applies stacking poison on hit."),
        (key: "spell_59", tier: Mechanic,
            text: "Applies Wet on hit, extinguishing Burning."),
        (key: "spell_60", tier: Mechanic,
            text: "Chills enemies and freezes Wet targets longer."),
        (key: "spell_61", tier: Mechanic,
            text: "Chains lightning to nearby enemies on impact."),
        (key: "spell_62", tier: Mechanic,
            text: "Damages nearby enemies with shards on impact.",
            codex: "Shards also apply the bolt's elemental status."),
        (key: "spell_63", tier: Mechanic,
            text: ""),
        (key: "spell_64", tier: Mechanic,
            text: "Fires the bolt behind the caster."),
        (key: "spell_65", tier: Mechanic,
            text: ""),
        (key: "spell_66", tier: Mechanic,
            text: "Passes through walls before resuming collision."),
        (key: "spell_67", tier: Mechanic,
            text: "Increases damage at a nonlethal health cost."),
        (key: "spell_68", tier: Mechanic,
            text: "Pays part of the mana cost in blood.",
            codex: "The wand refuses payment if it would leave too little health. It wants a repeat customer."),
        (key: "spell_69", tier: Mechanic,
            text: "Splits into sparks on impact.",
            codex: "The sparks use default modifiers and cannot fork again."),
        (key: "spell_70", tier: Mechanic,
            text: "Releases the following spell during flight.",
            codex: "Impact releases the payload if the timer has not elapsed."),
        (key: "spell_77", tier: Mechanic,
            text: "Restores mana on direct hits."),
        (key: "spell_78", tier: Mechanic,
            text: "May multiply direct hit damage."),
        (key: "spell_79", tier: Mechanic,
            text: "Releases the following spell on impact or expiry."),
        (key: "spell_88", tier: Mechanic,
            text: "Increases damage against Wet or chilled enemies."),
        (key: "spell_89", tier: Mechanic,
            text: "Explodes on impact, damaging enemies and the caster."),
        (key: "spell_90", tier: Mechanic,
            text: "Passes through enemies before stopping."),
        (key: "spell_91", tier: Mechanic,
            text: "Casts additional spells together in a fan."),
        (key: "spell_92", tier: Mechanic,
            text: "Releases the following spell on a wall ricochet.",
            codex: "Adds a ricochet. Impact can release the payload first."),
        (key: "spell_93", tier: Mechanic,
            text: "Releases the following spell near a visible enemy.",
            codex: "Impact can release the payload before proximity does."),
        (key: "spell_94", tier: Mechanic,
            text: "Pulls nearby enemies toward the impact."),
        (key: "spell_95", tier: Mechanic,
            text: "Moves selected water to a receiving surface.",
            codex: "Aim through water at the bed to select an intake, then cast at the destination. Sneak to change the intake. Blocked or full destinations cost nothing. Cast separately from multicasts. Reloading clears the intake and preserves transferred water."),
        (key: "spell_96", tier: Mechanic,
            text: "Sneak-cast at a pair of spots to link, then cast inside to travel.",
            codex: "Keep both landings clear. Sneak-cast elsewhere to move the far end, or inside to clear the pair. Cast outside a link for a temporary return mark. Hold the cast longer to escape to the first circle without a return link."),
        (key: "spell_97", tier: Mechanic,
            text: "Pulls visible dropped items toward the caster."),
        (key: "spell_98", tier: Mechanic,
            text: "Turns connected water into a shock trap for nearby enemies.",
            codex: "Flood the crossing, then cast into it. Keep a dry break in the circuit. Machines touching the water share the charge."),
        (key: "spell_99", tier: Mechanic,
            text: "Throws a returning thread that refunds its mana on the first enemy hit.",
            codex: "A miss on the way out is still a shot on the way back."),
        (key: "spell_0", tier: Mechanic,
            text: "Chains lightning between enemies and charges machines on impact."),
        (key: "spell_1", tier: Mechanic,
            text: ""),
        (key: "spell_2", tier: Mechanic,
            text: "Chills enemies and freezes water on impact."),
        (key: "spell_3", tier: Mechanic,
            text: "Blasts terrain and can hurt nearby enemies and the caster."),
        (key: "spell_4", tier: Mechanic,
            text: "Reflects incoming enemy bolts.",
            codex: "The ward comes with return postage."),
        (key: "spell_5", tier: Mechanic,
            text: "Creates a field that harms and slows enemies and heals the caster."),
        (key: "spell_6", tier: Mechanic,
            text: "Creates a field that pulls and damages enemies."),
        (key: "spell_7", tier: Mechanic,
            text: "Teleports along the aim direction to ground.",
            codex: "Stops before obstacles. Casting from the ground requires solid footing at the destination."),
        (key: "spell_8", tier: Standard,
            text: ""),
        (key: "spell_9", tier: Mechanic,
            text: "Cuts terrain and enemies along a beam."),
        (key: "spell_10", tier: Mechanic,
            text: "Consumes terrain in flight and pulls enemies inward."),
        (key: "spell_11", tier: Mechanic,
            text: "Hold Cast to steer a hot field that damages nearby enemies."),
        (key: "spell_12", tier: Mechanic,
            text: "Ignites ground, melts ice, and boils water on impact."),
        (key: "spell_13", tier: Mechanic,
            text: "Applies Frost, chills nearby enemies, and freezes water on impact."),
        (key: "spell_14", tier: Mechanic,
            text: "Shocks on impact and carries the charge through connected water.",
            codex: "Try a puddle before trying the whole moat."),
        (key: "spell_15", tier: Mechanic,
            text: "Transforms stone into ore or crystal, and soil into glowcaps."),
        (key: "spell_24", tier: Mechanic,
            text: "Fells the targeted tree."),
        (key: "spell_25", tier: Mechanic,
            text: "Staggers enemies and launches loose assemblies."),
        (key: "spell_28", tier: Mechanic,
            text: "Ignites ground where the seed lands."),
        (key: "spell_29", tier: Mechanic,
            text: "Drops a meteor that leaves a crater ringed with fire.",
            codex: "For outdoor use. The distinction may be academic after impact."),
        (key: "spell_30", tier: Mechanic,
            text: "Slows nearby enemies and hostile bolts."),
        (key: "spell_31", tier: Mechanic,
            text: "Pulls the caster toward the targeted block.",
            codex: "A cast without a reachable anchor costs no mana."),
        (key: "spell_32", tier: Mechanic,
            text: "Kicks the caster up and forward, even in midair.",
            codex: "The best time to cast is after missing the ledge."),
        (key: "spell_33", tier: Mechanic,
            text: "Hold Cast to block incoming enemy shots."),
        (key: "spell_34", tier: Mechanic,
            text: "Delivers attached effects at the aimed location.",
            codex: "Touch delivers attached effects at the aimed location. Without a trigger, Touch has no payload."),
        (key: "spell_35", tier: Mechanic,
            text: "Enlarges a lanterncap or grows a juvenile from soil.",
            codex: "Requires clearance. Soil only grows a new companion if the caster has none."),
        (key: "spell_36", tier: Mechanic,
            text: "Conjures a lanterncap unless a companion is owned.",
            codex: "Requires clearance at the delivery point."),
        (key: "spell_39", tier: Mechanic,
            text: "Shrinks a lanterncap to its previous size class."),
        (key: "spell_71", tier: Mechanic,
            text: "Cuts nearby enemies with a projectile."),
        (key: "spell_72", tier: Mechanic,
            text: "Teleports the caster to the impact when space permits."),
        (key: "spell_73", tier: Mechanic,
            text: "Floods the impact site and soaks nearby enemies.",
            codex: "Dig the ditch first. The lightning comes separately."),
        (key: "spell_74", tier: Mechanic,
            text: "Poisons visible enemies around the impact."),
        (key: "spell_75", tier: Mechanic,
            text: "Raises a wall of ice in front of the caster.",
            codex: "Useful cover. Keep away from Magma Glob."),
        (key: "spell_76", tier: Mechanic,
            text: "Ricochets off walls."),
        (key: "spell_80", tier: Mechanic,
            text: "Steers toward the nearest visible enemy."),
        (key: "spell_81", tier: Mechanic,
            text: "Chills enemies and freezes water on impact."),
        (key: "spell_82", tier: Mechanic,
            text: "Dissolves terrain and poisons enemies near impact."),
        (key: "spell_83", tier: Mechanic,
            text: "Shocks enemies and chains lightning between them."),
        (key: "spell_84", tier: Mechanic,
            text: "Pulls enemies inward while flying, then collapses."),
        (key: "spell_85", tier: Mechanic,
            text: "Ricochets with increasing speed, damaging enemies near each bounce."),
        (key: "spell_86", tier: Mechanic,
            text: "Cuts through terrain along its path."),
        (key: "spell_87", tier: Mechanic,
            text: "Fires a cone of pellets."),
        (key: "spell_100", tier: Mechanic,
            text: "Absorbs the next damaging landing.",
            codex: "The transit office classified falling as a form of arrival. It issued this spell to passengers whose complaints had yet to reach the ground."),

    ],
    // Flavour: one dim italic line under the stats, keyed by display name.
    // Never a number, an effect or an instruction; at most nine words, no
    // full stop. Proper nouns here are ones the codex already uses.
    flavours: [
        (name: "Torch", line: "Smells of pine tar and long shifts"),
        (name: "Bed", line: "Someone slept well here"),
        (name: "Chest", line: "Hinges oiled by whoever came before"),
        (name: "Tombstone", line: "The mason left room for more names"),
        (name: "Lectern", line: "Worn smooth where elbows rested"),
        (name: "Sign", line: "Says whatever it is told"),
        (name: "Ladder", line: "Every rung a little polished"),
        (name: "Lever", line: "Satisfying either way"),
        (name: "Oak door", line: "Sticks a little in wet weather"),
        (name: "Window glass", line: "Keeps the weather on its own side"),
        (name: "Anvil", line: "Rings truer on cold mornings"),
        (name: "Brewing stand", line: "Stained every colour at once"),
        (name: "Enchanting Table", line: "The pages turn when nobody looks"),
        (name: "Claim Stake", line: "Good fences, quiet neighbours"),
        (name: "TNT", line: "Short fuse, long memory"),
        (name: "Bread", line: "Still warm in the middle"),
        (name: "Egg", line: "Unbothered by its future"),
        (name: "Root stew", line: "Tastes of the pot it came from"),
        (name: "Harvest cake", line: "Baked when the fields are finally quiet"),
        (name: "Pumpkin pie", line: "Gone before it cools"),
        (name: "Raw Fish", line: "Looks back"),
        (name: "Cooked Fish", line: "Better with river air"),
        (name: "Fungal ration", line: "Keeps longer than morale"),
        (name: "Spore trailcake", line: "Dense enough to pave with"),
        (name: "Artificer workbench", line: "Scarred by better ideas"),
        (name: "Field smelter", line: "Fed by hand and patience"),
        (name: "Coal generator", line: "Coughs politely before starting"),
        (name: "Ore crusher", line: "Never asks what the rock did"),
        (name: "Mining drill", line: "Sings off-key through granite"),
        (name: "Water pump", line: "Thirsty work, done without complaint"),
        (name: "Battery bank", line: "Cells hum faintly when full"),
        (name: "Transformer", line: "Warm to lean against in winter"),
        (name: "Item pipe", line: "Something small rattles through now and then"),
        (name: "Power cable", line: "Tastes of nothing, reportedly"),
        (name: "Quarry", line: "Leaves a tidy hole and no apology"),
        (name: "Chimney", line: "The valley knows who is home"),
        (name: "Sealed salvage cache", line: "Packed by careful hands"),
        (name: "Rusted steel", line: "Outlasted whoever built it"),
        (name: "Concrete", line: "Grey, and proud of it"),
        (name: "Bedrock", line: "The world stops arguing here"),
        (name: "Resonant crystal", line: "Hums a note nobody taught it"),
        (name: "Star glass", line: "Cold as the sky it fell through"),
        (name: "Void stone", line: "Light goes in and stays"),
        (name: "Mithril", line: "Lighter than its reputation"),
        (name: "Gold", line: "Heavy in the hand, heavier in the head"),
        (name: "Luminous mushroom", line: "A night light for small things"),
        (name: "Ember mushroom", line: "Warm, and a little smug about it"),
        (name: "Mycelium", line: "It was here first"),
        (name: "Grove moss", line: "Green even in the dark"),
        (name: "Sapling", line: "Patient"),
        (name: "Lava", line: "Rock with strong opinions"),
        (name: "Ice", line: "Water, holding its breath"),
        (name: "Snow layer", line: "Quiet enough to hear"),
        (name: "Lily pad", line: "Reserved for frogs"),
        (name: "Cactus", line: "Hugs nobody"),
        (name: "Kelp", line: "Waves at passing fish"),
        (name: "Mana flower", line: "Leans toward spellwork like sun"),
        (name: "Bucket", line: "Dented in a familiar way"),
        (name: "Water Bucket", line: "Sloshes at the worst moments"),
        (name: "Lava Bucket", line: "Warm company on a cold walk"),
        (name: "Copper sword", line: "Green at the edges by spring"),
        (name: "Steel sword", line: "Keeps its opinions sharp"),
        (name: "Wooden pickaxe", line: "Borrowed from a tree"),
        (name: "Stone pickaxe", line: "A rock on a stick, improved"),
        (name: "Iron pickaxe", line: "Bites back"),
        (name: "Hang glider", line: "Folds smaller than courage"),
        (name: "Slime boots", line: "Squeak on the stairs"),
        (name: "Burner jetpack", line: "Smells of the last shift's fuel"),
    ],
    // Hints: what a Tool Station trait or modifier means, in plain words.
    // Keyed by display name; no numbers (those come from the stat lines).
    hints: [
        (name: "Conductive", line: "Carries electricity, so blades gain a shock edge"),
        (name: "Insulated grip", line: "Handle that blocks electricity"),
        (name: "Flammable", line: "Burns easily near fire"),
        (name: "Self-repair", line: "Living part that slowly mends the tool"),
        (name: "Jagged", line: "Crystal head that cuts deeper as it wears"),
        (name: "Magnetic", line: "Material that clings to iron"),
        (name: "Buoyant", line: "Lighter than water, so it floats"),
        (name: "Lava-proof", line: "Survives lava, so blades gain a fire edge"),
        (name: "Heavy", line: "Very dense material that adds weight"),
        (name: "Brittle", line: "Very hard but chips easily"),
        (name: "Lightweight", line: "Low density material"),
        (name: "Tempered", line: "Hard head that wears slowly"),
        (name: "Bouncy", line: "Soft living material that rebounds"),
        (name: "Haste", line: "Mines faster"),
        (name: "Reinforced", line: "Lasts longer but mines a little slower"),
        (name: "Sharp", line: "Deals more damage"),
        (name: "Sharpened", line: "Raises mining tier but costs durability"),
        (name: "Keen", line: "Small damage bonus"),
        (name: "Flux", line: "Each hit restores mana"),
        (name: "Core", line: "Finishing blows stagger enemies"),
        (name: "Moss", line: "Each hit restores health"),
        (name: "Runed", line: "Each hit deals bonus damage"),
        (name: "Spiked", line: "Attackers take damage back"),
    ],
)
