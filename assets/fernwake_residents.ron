// Resident voices and attributed records. Physical clues remain literal.
[
    (
        id: 7, name: "Receiving Clerk",
        ready: "The receiving bay is open. Arrivals are recorded by presence. It is our most reliable instrument.",
        bench: "The receiving counter is broken. A plank will restore it. A requisition would merely describe the plank.",
        water: "This is a dry store. Any water received here has been incorrectly addressed.",
        following: "I can leave the counter. After all these years, the freight can wait for me.",
        home: "I sleep better here. The old office kept receiving footsteps after the last shift had gone.",
        route: "The south stairs loop below the shutter. The service ledger is in the side archive off the lower gallery.",
        works: "A charged battery near the copper control opens the shutter. The south stairs also reach this bay. Neither route needs my permission.",
        rested: "The work is done. There is no fee for acknowledging that.",
        records: [
            (title: "A Working Office", text: "The clerk kept a bunk beside the receiving counter after the wages stopped. Somebody still had to receive the families coming up from below. The trade ledger begins in elaborate imperial script and ends with bread, blankets, names."),
            (title: "Service Access", text: "The lower gallery was built after a shutter failure trapped the night shift. Management called it a recreational promenade. Its lamps, broad stairs and route around the shutter remain useful, whatever the account books claim."),
        ],
    ),
    (
        id: 3, name: "Mara · Gardener",
        ready: "The beds have water. The empire called this an agricultural triumph. I call it Tuesday.",
        bench: "The workbench is missing a plank. I have filed the gap under furniture, provisionally.",
        water: "The channel is dry. The old supply office would count the absence of flooding as a success.",
        following: "I'll come. Someone should ask where the drains go before we establish a capital.",
        home: "Good soil. A roof. No ceremonial staircase. This is a considerable promotion.",
        route: "The cistern is west along the central passage. Its pale stairs overlook the water court.",
        works: "West, the cistern's timber stop holds back the upper water. The shelf below it is a service walk.",
        rested: "The beds are tended. Further encouragement today would be bullying.",
        waterworks: [
            "Water has reached the lower basin. The imperial completion ceremony would take six weeks. The water declined to wait.",
            "The lower basin is dry and the sluice is obstructed. A clear channel needs tools, despite what the old forms imply.",
            "The channel is open, but the lower basin is still dry. An open sluice is a promise; water is the useful part.",
        ],
        records: [
            (title: "Seed Ledger", text: "Mara keeps an imperial seed ledger beneath the potting bench. Each failed harvest has a different official cause. Each successful harvest names the same minister. In the margins, generations of gardeners have recorded the weather."),
            (title: "The Lower Gardens", text: "Mara's grandmother spoke of gardens beneath the cisterns, lit on a timetable that outlived the sun lamps. Their keepers still rang the dawn bell. She would not say what began answering it."),
        ],
    ),
    (
        id: 4, name: "Orrin · Boatwright",
        ready: "A sound bench and running water. The boatyard is now better equipped than the last admiralty.",
        bench: "My worktop has a hole. A useful demonstration of the principle I try to exclude from boats.",
        water: "The channel is dry. I can build a boat here, but launching it would be an act of optimism.",
        following: "I'll come. If there are stairs, I reserve the right to describe the route as unnavigable.",
        home: "I've moved the boatyard. The empire once did that by moving the river. This was cheaper.",
        route: "The gallery behind the orchard runs west to the surface stair. It is the return route; keep it clear.",
        works: "The gallery behind the orchard runs west to the surface stair. Even an imperial expedition benefits from an exit.",
        rested: "The work is done. There is no supplementary boat hiding in the invoice.",
        records: [
            (title: "Shipping Register", text: "Orrin inherited a shipping register with seven ports crossed out and their fees carefully retained. Beside the lowest port, a clerk wrote: 'Cargo returned. Vessel returned. River disputed.' The next page has been cut away."),
            (title: "Imperial Soundings", text: "Orrin says the old river survey measured depth by lowering a clerk on a rope. The method ended when one returned with seniority. He tells this as a joke, but will not sell the lead weights from that expedition."),
        ],
    ),
    (
        id: 5, name: "Sedge · Orchard Keeper",
        ready: "The trees are neighbours. The empire registered them as tenants. They are still declining to sign.",
        bench: "A plank is missing from the bench. The trees have asked me to exhaust the salvage options.",
        water: "The orchard channel is dry. Roots have little patience for statements of intent.",
        following: "I will walk a little way. Trees take longer to leave a place, and usually have better reasons.",
        home: "This will do. A home needs somewhere to grow into, not merely an address to defend.",
        route: "Beyond the orchard, the stone bridge crosses a lower river. The gallery behind us returns to the surface stair.",
        works: "Beyond the orchard, the stone bridge crosses a lower river. Listen before descending. Water is not the only thing carried here.",
        rested: "The saplings have been tended. They are growing at tree speed. There is no appeals process.",
        records: [
            (title: "Root Boundaries", text: "Sedge remembers surveyors arguing over a root that crossed three districts. They erected boundary stones around it. The root grew. The stones now stand inside the trunk, where their authority is presumably undiminished."),
            (title: "The Last Pruning", text: "One orchard account lists fruit, timber, lamp oil, then silence. Sedge says the lower keepers stopped pruning when branches began leaning towards a door that had been bricked up from both sides. The account gives no date for reopening."),
        ],
    ),
    (
        id: 6, name: "Pip · Household Sprite",
        ready: "I gather dropped things when asked. The empire called that confiscation and required a taller hat.",
        bench: "A missing plank is a doorway to some of us. I appreciate that this complicates the repair estimate.",
        water: "The channel is dry. No, I have not put the water somewhere safe.",
        following: "Coming. Please distinguish between lost property and luggage before we begin.",
        home: "I like this house. Its small spaces have not yet been assigned to a department.",
        route: "My low doorway is beside the orchard's west wall. The path outside fits taller visitors.",
        works: "My low doorway is beside the orchard's west wall. The empire overlooked it. I have continued the arrangement.",
        rested: "Everything collected was already lying about. This is a service, not a creation myth.",
        records: [
            (title: "Lost Property", text: "Pip has an imperial lost-property list: eleven umbrellas, a municipal boundary, and the westbound afternoon. The umbrellas were reclaimed. The other two were transferred downstairs, which appears to have been an acceptable answer to almost anything."),
            (title: "Below the Offices", text: "Pip says the lower offices had tiny doors before sprites moved in. Their handles are on the wrong side. Once, someone knocked politely from inside a sealed one. Pip returned the courtesy and has regretted it ever since."),
        ],
    ),
]
