// Provisional numbers until the system-scale spike (decision 0025). Ids only; names come from the human.
//
// Units: kg, m, s, degrees. Omitted Option fields are None. Time inside a system is tick time x time_scale.
// A semi-major axis is not stored; the rails derive it from the period and the combined parent and
// body mass: a^3 = G (M + m) T^2 / (4 pi^2), G = 6.674_30e-11.
//
// Masses
//   home   M = g R^2 / G for g = 9.81 m/s^2 at R = 20_371 m.
//   star   M = 4 pi^2 a^3 / (G T^2) for a = 1.5e8 m and the home period T = 11_520 s.
//   moon   engine_space::design_moon defaults: home's mean density (1.72e6 kg/m^3) at R = 4_000 m,
//          g = 1.93 m/s^2. A rocky 3e3 kg/m^3 moon would sit inside home's ~400 km fluid Roche limit.
//   giant  M = g R^2 / G for g = 24.8 m/s^2 at R = 600_000 m.
// Periods (home solar day = 480 s, sidereal day = 460.8 s)
//   home   11_520 s. Solar day 480 s, sidereal 460.8 s (55_296 ticks); year 24 solar days. a = 1.5e8 m.
//   moon   1_949.4 s, ~4.06 solar days; sidereal month. a = 73.4 km = 3.6 home radii = 0.45 of the
//          home Hill radius at periapsis (163.0 km), inside the 0.5 prograde stability limit and
//          outside the 49.7 km Roche limit. Sphere of influence 10.4 km = 2.6 moon radii.
//   giant  92_160 s = 8 home years. a = 6.0e8 m, 4 times the home orbit.
// Apparent size from home: star 0.92 deg, moon 8.6 deg at zenith, giant 0.15 deg at closest approach.
SystemsFile(
    systems: [
        SystemDef(
            id: "home",
            time_scale: 1.0,
            bodies: [
                BodyDef(
                    id: "star",
                    kind: Star(temperature_k: 5800.0),
                    mass_kg: 1.504e28,
                    radius_m: 1_200_000.0,
                    parent: None,
                    orbit: None,
                ),
                BodyDef(
                    id: "home",
                    kind: Planet,
                    mass_kg: 6.099_41e19,
                    radius_m: 20_371.0,
                    parent: Some("star"),
                    orbit: Some(OrbitDef(
                        period_s: 11_520.0,
                        e: 0.017,
                        i_deg: 0.0,
                        node_deg: 0.0,
                        peri_deg: 100.0,
                        mean_anomaly_deg: 0.0,
                    )),
                    rotation: Some(RotationDef(
                        period: Seconds(460.8),
                        tilt_deg: 23.4,
                        north_deg: 0.0,
                    )),
                ),
                BodyDef(
                    id: "moon",
                    kind: Moon,
                    mass_kg: 4.6178e17,
                    radius_m: 4_000.0,
                    parent: Some("home"),
                    orbit: Some(OrbitDef(
                        period_s: 1_949.4,
                        e: 0.02,
                        i_deg: 5.1,
                        node_deg: 0.0,
                        peri_deg: 0.0,
                        mean_anomaly_deg: 0.0,
                    )),
                    rotation: Some(RotationDef(
                        period: Locked,
                        tilt_deg: 0.0,
                        north_deg: 0.0,
                    )),
                ),
                BodyDef(
                    id: "giant",
                    kind: GasGiant,
                    mass_kg: 1.3377e23,
                    radius_m: 600_000.0,
                    parent: Some("star"),
                    orbit: Some(OrbitDef(
                        period_s: 92_160.0,
                        e: 0.05,
                        i_deg: 1.3,
                        node_deg: 100.0,
                        peri_deg: 270.0,
                        mean_anomaly_deg: 40.0,
                    )),
                    rotation: Some(RotationDef(
                        period: Seconds(200.0),
                        // The sky draws the ring about this axis; 240 degrees keeps it 20-27 degrees open from home
                        // over the first 24 days.
                        tilt_deg: 26.7,
                        north_deg: 240.0,
                    )),
                ),
            ],
        ),
    ],
)
