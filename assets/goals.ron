// Guidance track, offered in row order: the HUD shows the first unmet row.
// `id` is saved in goals.vxg: lowercase, digits and underscores; never rename a shipped id.
// Conditions: HasItem(item, count), Placed(block), Machine(kind), Event(Ate | Slept |
// NightSurvived | GateAttuned | GatesLinked | HedronCaptured | CircleDrawn | WorkshopEntered |
// SpellCast | LiftBoarded | CrownReached | DrillDelivered | FieldSmelted | FurnaceIngot), GuardianDefeated.
// Optional rows can be completed at any time and never hold up the tracker.
// Goal tiers group Workshop, Survival, Base, Machine, Power, Magic, Guardian, Portal and Orbit.
// Rows the starting kit already meets are credited silently when a world begins;
// a world without a starter workshop skips WorkshopEntered. Order is the order offered; ids are
// saved, so reorder or retitle freely but never rename an id.
// `cargo test goals_ron_round_trips` checks the format.
[
    (
        id: "enter_workshop",
        tier: Home,
        title: "Enter Workshop",
        action: "Follow the compass to the workshop and step inside.",
        condition: Event(WorkshopEntered),
    ),
    (
        id: "logs",
        tier: Survival,
        title: "Logs",
        action: "[Break] Hold on a log. Walk over drops.",
        condition: HasItem(Block(Log), 2),
    ),
    (
        id: "planks",
        tier: Survival,
        title: "Planks",
        action: "[Inventory] Craft planks from logs.",
        condition: HasItem(Block(Planks), 8),
    ),
    (
        id: "workbench",
        tier: Survival,
        title: "Workbench",
        action: "[Inventory] Craft a workbench.",
        condition: HasItem(Block(Workbench), 1),
    ),
    (
        id: "wooden_axe",
        tier: Survival,
        title: "Wooden Axe",
        action: "Place the bench. Craft with four planks.",
        condition: HasItem(Tool(12), 1),
        optional: true,
    ),
    (
        id: "timber",
        tier: Survival,
        title: "Timber",
        action: "Axe the trunk base. Collect fallen logs.",
        condition: HasItem(Block(Log), 8),
        optional: true,
    ),
    (
        id: "ration",
        tier: Survival,
        title: "Fungal Ration",
        action: "[Inventory] Eat a ration when hunger runs low.",
        condition: HasItem(Food(FungalRation), 1),
        optional: true,
    ),
    (
        id: "meal",
        tier: Survival,
        title: "Meal",
        action: "Hold a food and use it. Eating also heals slowly.",
        condition: Event(Ate),
        optional: true,
    ),
    (
        id: "torches",
        tier: Base,
        title: "Torches",
        action: "[Inventory] Craft torches. Light a room with walls and a roof, or use the workshop.",
        condition: HasItem(Block(Torch), 4),
    ),
    (
        id: "bed",
        tier: Base,
        title: "Bed",
        action: "Place a bed, or use the one in the workshop. Sleeping sets the respawn point.",
        condition: Placed(Bed),
        optional: true,
    ),
    (
        id: "first_night",
        tier: Base,
        title: "First Night",
        action: "Stay near light until dawn. Sleeping in a bed also counts.",
        condition: Event(NightSurvived),
        optional: true,
    ),
    (
        id: "sleep",
        tier: Base,
        title: "Sleep",
        action: "Use a bed at night to skip to morning.",
        condition: Event(Slept),
        optional: true,
    ),
    (
        id: "wooden_pickaxe",
        tier: Survival,
        title: "Wooden Pickaxe",
        action: "[F] Open a placed workbench and craft a pickaxe from planks.",
        condition: HasItem(Tool(6), 1),
    ),
    (
        id: "cobblestone",
        tier: Machine,
        title: "Cobblestone",
        action: "[Break] Mine exposed stone with a pickaxe. Craft the stone into cobblestone.",
        condition: HasItem(Block(Cobblestone), 4),
    ),
    (
        id: "stone_pickaxe",
        tier: Machine,
        title: "Stone Pickaxe",
        action: "[F] Use a workbench to upgrade to stone. Take it underground for ore.",
        condition: HasItem(Tool(7), 1),
    ),
    (
        id: "ore_processor",
        tier: Machine,
        title: "Field smelter",
        action: "Carry copper ore and coal from exposed rock or a cave. Place a Field smelter and use [F].",
        condition: Event(FieldSmelted),
        recipe: Some(Block(Smelter)),
    ),
    (
        id: "copper_ingots",
        tier: Machine,
        title: "Copper Ingots",
        action: "[F] Use a Field smelter with ore and coal in your pack. Each ingot takes 1 ore and ¼ coal.",
        condition: HasItem(Resource(6), 2),
        optional: true,
    ),
    (
        id: "iron_ingots",
        tier: Power,
        title: "Iron Ingots",
        action: "[F] Smelt iron ore from underground. Save three ingots for a pickaxe.",
        condition: HasItem(Resource(8), 3),
    ),
    (
        id: "iron_pickaxe",
        tier: Power,
        title: "Iron Pickaxe",
        action: "[F] Craft at a workbench. Take it into deeper caves.",
        condition: HasItem(Tool(8), 1),
    ),
    (
        id: "coal_generator",
        tier: Power,
        title: "Coal Generator",
        action: "Place a Coal Generator outdoors. Open it with [F] and select Load All Fuel.",
        condition: Machine(Generator),
    ),
    (
        id: "first_powered_ingot",
        tier: Power,
        title: "Power Your First Furnace",
        action: "Cable the generator to an Electric furnace. Open it with [F], select Ore mode and supply raw ore.",
        condition: Event(FurnaceIngot),
        recipe: Some(Block(ElectricFurnace)),
    ),
    (
        id: "mining_drill",
        tier: Power,
        title: "Mining Drill",
        action: "Place a Mining Drill over an exposed ore vein. Link it to the generator with power cable.",
        condition: Machine(MiningDrill),
        optional: true,
    ),
    (
        id: "ore_line",
        tier: Power,
        title: "Ore Line",
        action: "Connect the drill to an Output crate with Item pipe. Check both ports, then wait for ore to arrive.",
        condition: Event(DrillDelivered),
        recipe: Some(Block(ItemPipe)),
        optional: true,
    ),
    (
        id: "cast_spell",
        tier: Magic,
        title: "Cast a Spell",
        action: "Select your starter wand and use [Cast].",
        condition: Event(SpellCast),
        optional: true,
    ),
    (
        id: "ritual_circle",
        tier: Magic,
        title: "Ritual Circle",
        action: "[Inventory] Wand page: write a RING phrase, then Draw Circle.",
        condition: Event(CircleDrawn),
        optional: true,
    ),
    (
        id: "guardian_cleared",
        tier: Guardian,
        title: "Defeat a Guardian",
        action: "Take a wand or sword down the workshop mine and defeat the guardian in the vault.",
        condition: GuardianDefeated,
        optional: true,
    ),
    (
        id: "crystal_blocks",
        tier: Portal,
        title: "Crystal Blocks",
        action: "[Break] Mine crystal in caves and ruins.",
        condition: HasItem(Block(Crystal), 12),
    ),
    (
        id: "crystal_ring",
        tier: Portal,
        title: "Crystal Ring",
        action: "Place crystal blocks in a ring to build a gate.",
        condition: Placed(Crystal),
    ),
    (
        id: "gate_attuned",
        tier: Portal,
        title: "Gate Attuned",
        action: "Stand in the ring and use the gate to attune it.",
        condition: Event(GateAttuned),
    ),
    (
        id: "gates_linked",
        tier: Portal,
        title: "Gate Link",
        action: "Attune a second gate, then link the pair.",
        condition: Event(GatesLinked),
    ),
    (
        id: "hedron_captured",
        tier: Portal,
        title: "Hedron Captured",
        action: "Find a hedron on its plinth beside a ruin. Raise a 2-block pylon of its block on each of the 4 sockets.",
        condition: Event(HedronCaptured),
    ),
    (
        id: "lift_boarded",
        tier: Orbit,
        title: "Board the Express Lift",
        action: "Find an express lift terminal on the map and board the cabin.",
        condition: Event(LiftBoarded),
    ),
    (
        id: "crown_reached",
        tier: Orbit,
        title: "Reach Orbit",
        action: "Ride to the crown anchorage at the top and dock.",
        condition: Event(CrownReached),
    ),
]
