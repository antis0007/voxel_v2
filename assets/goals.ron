// Guidance track, offered in row order: the HUD shows the first unmet row.
// `id` is saved in goals.vxg: lowercase, digits and underscores; never rename a shipped id.
// Conditions: HasItem(item, count), Placed(block), Machine(kind), Event(Ate | Slept |
// NightSurvived | GateAttuned | GatesLinked | HedronCaptured | CircleDrawn | WorkshopEntered |
// SpellCast | LiftBoarded | CrownReached), Stocked(source_machine, sink_machine), GuardianDefeated.
// The track is one spine of nine acts: Workshop, Survival, Base, Machine, Power, Magic, Guardian,
// Portal, Orbit. Rows the starting kit already meets are credited silently when a world begins;
// a world without a starter workshop skips WorkshopEntered. Order is the order offered; ids are
// saved, so reorder or retitle freely but never rename an id.
// `cargo test goals_ron_round_trips` checks the format.
[
    (
        id: "enter_workshop",
        tier: Home,
        title: "Enter Workshop",
        action: "Follow the compass to the workshop and step inside.",
        condition: Event(WorkshopEntered),
    ),
    (
        id: "logs",
        tier: Survival,
        title: "Logs",
        action: "[Break] Hold on a log. Walk over drops.",
        condition: HasItem(Block(Log), 2),
    ),
    (
        id: "planks",
        tier: Survival,
        title: "Planks",
        action: "[Inventory] Craft planks from logs.",
        condition: HasItem(Block(Planks), 8),
    ),
    (
        id: "workbench",
        tier: Survival,
        title: "Workbench",
        action: "[Inventory] Craft a workbench.",
        condition: HasItem(Block(Workbench), 1),
    ),
    (
        id: "wooden_axe",
        tier: Survival,
        title: "Wooden Axe",
        action: "Place the bench. Craft with four planks.",
        condition: HasItem(Tool(12), 1),
    ),
    (
        id: "timber",
        tier: Survival,
        title: "Timber",
        action: "Axe the trunk base. Collect fallen logs.",
        condition: HasItem(Block(Log), 8),
    ),
    (
        id: "ration",
        tier: Survival,
        title: "Fungal Ration",
        action: "[Inventory] Eat a ration when hunger runs low.",
        condition: HasItem(Food(FungalRation), 1),
    ),
    (
        id: "meal",
        tier: Survival,
        title: "Meal",
        action: "Hold a food and use it. Eating also heals slowly.",
        condition: Event(Ate),
    ),
    (
        id: "torches",
        tier: Base,
        title: "Torches",
        action: "[Inventory] Torches light a base and keep monsters off.",
        condition: HasItem(Block(Torch), 4),
    ),
    (
        id: "bed",
        tier: Base,
        title: "Bed",
        action: "Place a bed, or use the one in the workshop. Sleeping sets the respawn point.",
        condition: Placed(Bed),
    ),
    (
        id: "first_night",
        tier: Base,
        title: "First Night",
        action: "Stay near light until dawn. Sleeping in a bed also counts.",
        condition: Event(NightSurvived),
    ),
    (
        id: "sleep",
        tier: Base,
        title: "Sleep",
        action: "Use a bed at night to skip to morning.",
        condition: Event(Slept),
    ),
    (
        id: "cobblestone",
        tier: Machine,
        title: "Cobblestone",
        action: "[Break] Mine stone. Cobblestone smelts and builds.",
        condition: HasItem(Block(Cobblestone), 4),
    ),
    (
        id: "ore_processor",
        tier: Machine,
        title: "Ore Processor",
        action: "[Inventory] Craft an Ore Processor and place it. Feed it ore and coal.",
        condition: Placed(Smelter),
    ),
    (
        id: "copper_ingots",
        tier: Machine,
        title: "Copper Ingots",
        action: "Put copper ore and coal in the Ore Processor, then take the ingots.",
        condition: HasItem(Resource(6), 2),
    ),
    (
        id: "iron_ingots",
        tier: Power,
        title: "Iron Ingots",
        action: "Smelt iron ore the same way. Iron makes tools and machines.",
        condition: HasItem(Resource(8), 2),
    ),
    (
        id: "coal_generator",
        tier: Power,
        title: "Coal Generator",
        action: "[Inventory] Craft a Coal Generator and place it. Feed it coal.",
        condition: Machine(Generator),
    ),
    (
        id: "mining_drill",
        tier: Power,
        title: "Mining Drill",
        action: "[Inventory] Craft a Mining Drill, place it on ore and power it.",
        condition: Machine(MiningDrill),
    ),
    (
        id: "ore_line",
        tier: Power,
        title: "Ore Line",
        action: "Run an item pipe from the drill to an output crate and let ore arrive.",
        condition: Stocked(MiningDrill, Storage),
    ),
    (
        id: "cast_spell",
        tier: Magic,
        title: "Cast a Spell",
        action: "The first wand sits in the hotbar. Select it and hold the cast key.",
        condition: Event(SpellCast),
    ),
    (
        id: "ritual_circle",
        tier: Magic,
        title: "Ritual Circle",
        action: "[Inventory] Wand page: write a RING phrase, then Draw Circle.",
        condition: Event(CircleDrawn),
    ),
    (
        id: "guardian_cleared",
        tier: Guardian,
        title: "Defeat a Guardian",
        action: "Take a wand or sword down the workshop mine and defeat the guardian in the vault.",
        condition: GuardianDefeated,
    ),
    (
        id: "crystal_blocks",
        tier: Portal,
        title: "Crystal Blocks",
        action: "[Break] Mine crystal in caves and ruins.",
        condition: HasItem(Block(Crystal), 12),
    ),
    (
        id: "crystal_ring",
        tier: Portal,
        title: "Crystal Ring",
        action: "Place crystal blocks in a ring to build a gate.",
        condition: Placed(Crystal),
    ),
    (
        id: "gate_attuned",
        tier: Portal,
        title: "Gate Attuned",
        action: "Stand in the ring and use the gate to attune it.",
        condition: Event(GateAttuned),
    ),
    (
        id: "gates_linked",
        tier: Portal,
        title: "Gate Link",
        action: "Attune a second gate, then link the pair.",
        condition: Event(GatesLinked),
    ),
    (
        id: "hedron_captured",
        tier: Portal,
        title: "Hedron Captured",
        action: "Find a hedron on its plinth beside a ruin. Raise a 2-block pylon of its block on each of the 4 sockets.",
        condition: Event(HedronCaptured),
    ),
    (
        id: "lift_boarded",
        tier: Orbit,
        title: "Board the Express Lift",
        action: "Find an express lift terminal on the map and board the cabin.",
        condition: Event(LiftBoarded),
    ),
    (
        id: "crown_reached",
        tier: Orbit,
        title: "Reach Orbit",
        action: "Ride to the crown anchorage at the top and dock.",
        condition: Event(CrownReached),
    ),
]
