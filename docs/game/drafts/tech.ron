        (id: "electric.high_voltage", tier: ElectricII, requires: ["electric.battery"], unlocks: ["transformer", "hv_cable"], grants: []),
        (id: "electric.storage_network", tier: ElectricII, requires: ["electric.signal", "electric.high_voltage"], unlocks: ["storage_controller", "storage_drive", "autocraft_planner"], grants: []),
        (id: "electric.controller", tier: ElectricII, requires: ["electric.signal"], unlocks: ["program_controller"], grants: []),
        (id: "electric.drone", tier: ElectricII, requires: ["electric.controller", "electric.storage_network"], unlocks: ["logistics_drone"], grants: [Flight]),
