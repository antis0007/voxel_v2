{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/scripts/workflow.py\" hook prompt", "timeout": 10}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell",
        "hooks": [
          {"type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/scripts/workflow.py\" hook pre", "timeout": 10}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell",
        "hooks": [
          {"type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/scripts/workflow.py\" hook post", "timeout": 10}
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell",
        "hooks": [
          {"type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/scripts/workflow.py\" hook post", "timeout": 10}
        ]
      }
    ]
  }
}
